{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "browser",
    "tools"
  ]
}
